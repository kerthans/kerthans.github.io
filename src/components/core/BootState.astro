<div class="boot-state" data-boot-state aria-hidden="true">
  <div class="boot-state__sequence meta-text">
    <span>SR / 01</span>
    <span>SHANGHAI · UTC+8</span>
    <span>SCANNING FIELD</span>
    <span>SIGNAL ACQUIRED</span>
  </div>
</div>

<script>
  const boot = document.querySelector('[data-boot-state]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const seen = sessionStorage.getItem('sr01-boot-complete');

  if (boot && (seen || reduceMotion)) {
    boot.remove();
  } else if (boot) {
    sessionStorage.setItem('sr01-boot-complete', 'true');
    window.setTimeout(() => boot.remove(), 1100);
  }
</script>

<style>
  .boot-state {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    background: var(--void-deep);
    animation: boot-exit 360ms var(--ease-out) 820ms forwards;
  }

  .boot-state__sequence {
    display: grid;
    gap: 0.55rem;
    min-width: min(19rem, 80vw);
    color: var(--text-muted);
  }

  .boot-state__sequence span {
    opacity: 0;
    animation: boot-fade 420ms var(--ease-out) forwards;
  }

  .boot-state__sequence span:nth-child(2) {
    animation-delay: 130ms;
  }

  .boot-state__sequence span:nth-child(3) {
    animation-delay: 260ms;
  }

  .boot-state__sequence span:nth-child(4) {
    color: var(--text-primary);
    animation-delay: 430ms;
  }
</style>
