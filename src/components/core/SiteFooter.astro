---
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__inner site-shell">
    <div>
      {locale === 'zh-CN' ? (
        <p>做东西，交付，<br />再从反馈里改。</p>
      ) : (
        <p>BUILD IT, SHIP IT,<br />IMPROVE IT FROM FEEDBACK.</p>
      )}
    </div>
    <div class="site-footer__meta meta-text">
      <span>岳一扬 / YIYANG YUE</span>
      <span>SHANGHAI</span>
      <span>2024-2026</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(7rem, 16vw, 15rem);
    border-top: 1px solid var(--line);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 0.28fr);
    gap: 3rem;
    padding-top: 3rem;
    padding-bottom: 3.5rem;
  }

  .site-footer p {
    margin: 0 0 1.15rem;
    color: var(--text-secondary);
    font-size: clamp(1.15rem, 1.7vw, 1.65rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
  }

  .site-footer__meta {
    display: grid;
    gap: 0.45rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
