---
interface ContentBlock {
  label: string;
  title: string;
  body: string;
  items?: string[];
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  blocks: ContentBlock[];
}

const { eyebrow, title, intro, blocks } = Astro.props;
---

<main class="content-page site-shell">
  <header class="content-page__hero">
    <p class="meta-text">{eyebrow}</p>
    <h1 class="section-display" set:html={title}></h1>
    <p class="body-large">{intro}</p>
  </header>

  <section class="content-page__blocks">
    {blocks.map((block) => (
      <article class="content-block">
        <div class="hairline"></div>
        <div class="content-block__grid">
          <span class="meta-text">{block.label}</span>
          <div>
            <h2>{block.title}</h2>
            <p class="body-copy">{block.body}</p>
            {block.items && (
              <ul class="content-block__items meta-text">
                {block.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>
</main>

<style>
  .content-page {
    min-height: 72dvh;
    padding-top: clamp(8rem, 12vw, 11rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .content-page__hero {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  .content-page__hero > .meta-text {
    margin: 0;
    color: var(--text-muted);
  }

  .content-page__hero > .body-large {
    max-width: 54rem;
    margin: 0 0 0 calc(18% + 1rem);
    color: var(--text-secondary);
  }

  .content-page__blocks {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .content-block__grid {
    display: grid;
    grid-template-columns: minmax(6rem, 0.18fr) 1fr;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.75rem) 0;
  }

  .content-block__grid > .meta-text {
    color: var(--text-muted);
  }

  .content-block h2 {
    max-width: 50rem;
    margin: 0 0 1rem;
    color: var(--text-primary);
    font-size: clamp(1.45rem, 2.6vw, 2.35rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .content-block p {
    max-width: 52rem;
    margin: 0;
  }

  .content-block__items {
    display: grid;
    gap: 0.7rem;
    max-width: 42rem;
    margin: 1.75rem 0 0;
    padding: 0;
    color: var(--text-secondary);
    list-style: none;
  }

  .content-block__items li {
    padding-left: 1rem;
    border-left: 1px solid var(--line-active);
  }

  @media (max-width: 720px) {
    .content-page__hero > .body-large {
      margin-left: 0;
    }

    .content-block__grid {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }
  }
</style>
