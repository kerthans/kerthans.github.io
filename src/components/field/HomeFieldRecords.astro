---
import { getCollection } from 'astro:content';
import FieldRecordPreview from './FieldRecordPreview.astro';
import type { Locale } from '../../i18n/utils';
import { sortWorkEntries, workDetailPath } from '../../lib/work';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const entries = sortWorkEntries(await getCollection('work', ({ data }) => data.locale === locale));

const typeLabels: Record<string, string> = zh
  ? { system: '系统', research: '研究', infrastructure: '基础设施' }
  : { system: 'SYSTEM', research: 'RESEARCH', infrastructure: 'INFRASTRUCTURE' };
---

<section class="home-records" aria-label={zh ? '项目' : 'Projects'}>
  <div class="site-shell home-records__intro">
    <div class="section-meta">
      <span>03</span>
      <span>{zh ? '系统与实验' : 'SYSTEMS & EXPERIMENTS'}</span>
    </div>
    <h2 class="section-display">
      {zh ? '做过的系统和实验。' : "Systems and experiments I've built."}
    </h2>
  </div>

  {entries.map((entry) => (
    <FieldRecordPreview
      locale={locale}
      index={entry.data.record}
      signalType={typeLabels[entry.data.type] ?? entry.data.type}
      projectName={entry.data.title}
      coreQuestion={entry.data.thesis}
      metadata={entry.data.metrics ?? []}
      insight={entry.data.insight}
      recordUrl={workDetailPath(locale, entry)}
    />
  ))}
</section>

<style>
  .home-records {
    padding-top: clamp(8rem, 16vw, 15rem);
  }

  .home-records__intro {
    display: grid;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .home-records__intro .section-display {
    max-width: 58rem;
  }
</style>
