---
import type { Locale } from '../../i18n/utils';
import type { WorkEntry } from '../../lib/work';

interface Props {
  entry: WorkEntry;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const zh = locale === 'zh-CN';

const statusLabels: Record<WorkEntry['data']['status'], string> = zh
  ? { live: '已上线', active: '进行中', paused: '暂停', archived: '归档' }
  : { live: 'LIVE', active: 'ACTIVE', paused: 'PAUSED', archived: 'ARCHIVED' };

const typeLabels: Record<string, string> = zh
  ? { system: '系统', research: '研究', infrastructure: '基础设施' }
  : { system: 'SYSTEM', research: 'RESEARCH', infrastructure: 'INFRASTRUCTURE' };
---

<article class="work-detail site-shell">
  <header class="work-detail__hero">
    <div class="section-meta work-detail__meta">
      <span>{zh ? '项目' : 'PROJECT'}</span>
      <span>{entry.data.record} / {statusLabels[entry.data.status]}</span>
    </div>

    <div class="work-detail__title-row">
      <p class="meta-text">{typeLabels[entry.data.type] ?? entry.data.type} / {entry.data.year}</p>
      <h1 class="work-detail__title">{entry.data.title}</h1>
    </div>

    <p class="body-large work-detail__thesis">{entry.data.thesis}</p>
  </header>

  <section class="work-detail__panel" aria-label={zh ? '记录摘要' : 'Record summary'}>
    <div class="hairline"></div>
    <div class="work-detail__row">
      <span class="meta-text">{zh ? '一句话结论' : 'TAKEAWAY'}</span>
      <p class="body-large">{entry.data.insight}</p>
    </div>
    <div class="hairline"></div>
    <div class="work-detail__row">
      <span class="meta-text">{zh ? '元数据' : 'METADATA'}</span>
      <div class="work-detail__metrics meta-text">
        {(entry.data.metrics ?? []).map((metric) => <span><strong>{metric.value}</strong> {metric.label}</span>)}
      </div>
    </div>
    <div class="hairline"></div>
    <div class="work-detail__row">
      <span class="meta-text">{zh ? '截图' : 'SCREENSHOT'}</span>
      <p class="body-copy">
        {entry.data.heroArtifact ? (zh ? '产品截图待补。' : 'Product screenshots pending.') : (zh ? '暂无截图。' : 'No screenshots attached yet.')}
      </p>
    </div>
  </section>

  <section class="work-detail__body" aria-label={zh ? '项目正文' : 'Project body'}>
    <slot />
  </section>
</article>

<style>
  .work-detail {
    padding-top: clamp(8rem, 12vw, 11rem);
    padding-bottom: clamp(6rem, 12vw, 10rem);
  }

  .work-detail__hero {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .work-detail__meta {
    margin-bottom: 1rem;
  }

  .work-detail__title-row {
    display: grid;
    grid-template-columns: minmax(6rem, 0.18fr) 1fr;
    gap: 1rem;
    align-items: start;
  }

  .work-detail__title-row .meta-text {
    margin: 0.65rem 0 0;
    color: var(--text-muted);
  }

  .work-detail__title {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--project-display);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .work-detail__thesis {
    max-width: 54rem;
    margin: 0 0 0 calc(18% + 1rem);
    color: var(--text-secondary);
  }

  .work-detail__panel {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .work-detail__row {
    display: grid;
    grid-template-columns: minmax(6rem, 0.18fr) 1fr;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  .work-detail__row > .meta-text {
    color: var(--text-muted);
  }

  .work-detail__row p {
    max-width: 54rem;
    margin: 0;
  }

  .work-detail__metrics {
    display: grid;
    gap: 0.55rem;
    color: var(--text-secondary);
  }

  .work-detail__metrics strong {
    display: inline-block;
    min-width: 8rem;
    color: var(--text-primary);
    font-weight: 400;
  }

  .work-detail__body {
    max-width: 58rem;
    margin: clamp(4rem, 8vw, 7rem) 0 0 calc(18% + 1rem);
  }

  .work-detail__body :global(h2) {
    margin: 4rem 0 1.1rem;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: var(--meta);
    font-weight: 400;
    letter-spacing: 0.14em;
    line-height: 1.65;
    text-transform: uppercase;
  }

  .work-detail__body :global(p) {
    margin: 0 0 1.35rem;
    color: var(--text-secondary);
    font-size: var(--body);
    line-height: 1.8;
  }

  .work-detail__body :global(strong) {
    color: var(--text-primary);
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .work-detail__title-row,
    .work-detail__row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .work-detail__thesis,
    .work-detail__body {
      margin-left: 0;
    }
  }
</style>
