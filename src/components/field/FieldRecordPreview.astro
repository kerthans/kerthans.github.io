---
import type { Locale } from '../../i18n/utils';

interface Props {
  locale: Locale;
  index: string;
  signalType: string;
  projectName: string;
  coreQuestion: string;
  metadata: Array<{ value: string; label: string }>;
  insight: string;
  recordUrl: string;
}

const {
  locale,
  index,
  signalType,
  projectName,
  coreQuestion,
  metadata = [],
  insight,
  recordUrl,
} = Astro.props;

const zh = locale === 'zh-CN';
---

<section class="field-record site-shell">
  <div class="field-record__header">
    <span class="meta-text">{zh ? '索引' : 'INDEX'}</span>
    <span class="field-record__index">{index}</span>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '类型' : 'TYPE'}</span>
    <span class="field-record__value body-large">{signalType}</span>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '项目名称' : 'PROJECT NAME'}</span>
    <span class="field-record__value field-record__project">{projectName}</span>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '核心问题' : 'THE QUESTION'}</span>
    <p class="field-record__value body-large">{coreQuestion}</p>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '元数据 / 指标' : 'METADATA / METRICS'}</span>
    <div class="field-record__metrics meta-text">
      {
        metadata.map((m) => (
          <span><strong>{m.value}</strong> {m.label}</span>
        ))
      }
    </div>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '一句话结论' : 'TAKEAWAY'}</span>
    <p class="field-record__value body-large">{insight}</p>
  </div>

  <div class="hairline"></div>

  <div class="field-record__row">
    <span class="field-record__label meta-text">{zh ? '截图' : 'SCREENSHOT'}</span>
    <div class="field-record__artifact">
      <span class="meta-text">{zh ? '截图待补' : 'PENDING'}</span>
    </div>
  </div>

  <div class="hairline"></div>

  <div class="field-record__open">
    <a class="field-record__link meta-text" href={recordUrl}>
      {zh ? '查看项目 ↗' : 'VIEW PROJECT ↗'}
    </a>
  </div>
</section>

<style>
  .field-record {
    padding-top: clamp(4rem, 8vw, 8rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .field-record__header {
    display: grid;
    grid-template-columns: minmax(6rem, 0.18fr) 1fr;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .field-record__header .meta-text {
    color: var(--text-muted);
  }

  .field-record__index {
    font-size: var(--section-display);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--text-primary);
  }

  .field-record__row {
    display: grid;
    grid-template-columns: minmax(6rem, 0.18fr) 1fr;
    gap: 1rem;
    align-items: start;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  .field-record__label {
    color: var(--text-muted);
  }

  .field-record__value {
    margin: 0;
    max-width: 52rem;
  }

  .field-record__project {
    font-size: var(--project-display);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .field-record__metrics {
    display: grid;
    gap: 0.55rem;
    color: var(--text-secondary);
  }

  .field-record__metrics strong {
    min-width: 8rem;
    display: inline-block;
    color: var(--text-primary);
    font-weight: 400;
  }

  .field-record__artifact {
    min-height: 10rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--surface-soft);
  }

  .field-record__artifact .meta-text {
    color: var(--text-ghost);
    letter-spacing: 0.24em;
  }

  .field-record__open {
    display: grid;
    justify-items: end;
    padding-top: 1.5rem;
  }

  .field-record__link {
    display: inline-grid;
    padding-bottom: 0.7rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--line-active);
    transition: color 260ms var(--ease-out), border-color 260ms var(--ease-out), transform 260ms var(--ease-out);
  }

  .field-record__link:hover {
    color: var(--amethyst);
    border-color: var(--amethyst);
    transform: translateX(0.35rem);
  }

  @media (max-width: 720px) {
    .field-record__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .field-record__header {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .field-record__open {
      justify-items: start;
    }
  }
</style>
