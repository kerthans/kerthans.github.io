---
import type { Locale } from '../../i18n/utils';
import { labels } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = labels[locale].systemMap;
---

<section class="system-map site-shell" data-system-map data-locale={locale}>
  <div class="section-meta">
    <span>02</span>
    <span>{t.label}</span>
  </div>

  <h2 class="section-display" set:html={t.headline}></h2>

  <div class="sysmap__grid">
    <span class="sysmap__project meta-text">TRACE-COVER</span>
    <span class="sysmap__project meta-text">AgentRT</span>
    <span class="sysmap__project meta-text">Ossa</span>
    <span class="sysmap__project meta-text">ProQuote</span>

    <div class="sysmap__stem" style="grid-column: 1" aria-hidden="true"></div>
    <div class="sysmap__stem" style="grid-column: 2" aria-hidden="true"></div>
    <div class="sysmap__stem" style="grid-column: 3" aria-hidden="true"></div>
    <div class="sysmap__stem" style="grid-column: 4" aria-hidden="true"></div>

    <div class="sysmap__crossbar" aria-hidden="true"></div>

    {t.territories.map((territory) => <span class="sysmap__territory" set:html={territory.replace('\n', '<br />')}></span>)}
  </div>

  <div class="sysmap__bridge">
    <span class="meta-text">Vulcan</span>
    <span class="sysmap__bridge-rule" aria-hidden="true"></span>
    <span class="meta-text sysmap__bridge-label">{t.bridge}</span>
  </div>
</section>

<style>
  .system-map {
    padding-top: clamp(8rem, 16vw, 15rem);
  }

  .sysmap__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto 2.5rem auto;
    column-gap: clamp(1rem, 3vw, 3rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .system-map .section-display {
    margin-top: clamp(3rem, 7vw, 6rem);
  }

  .sysmap__project {
    grid-row: 1;
    justify-self: center;
    text-align: center;
    color: var(--text-muted);
    padding-bottom: 0.65rem;
    font-size: clamp(0.55rem, 1.2vw, var(--meta));
    white-space: nowrap;
  }

  .sysmap__stem {
    grid-row: 2;
    justify-self: center;
    width: 1px;
    height: 100%;
    background: var(--line-active);
  }

  .sysmap__crossbar {
    grid-column: 1 / -1;
    grid-row: 2;
    height: 1px;
    background: var(--line);
    align-self: center;
    pointer-events: none;
  }

  .sysmap__territory {
    grid-row: 3;
    justify-self: center;
    text-align: center;
    padding-top: 0.5rem;
    font-size: clamp(1.25rem, 2.8vw, 2.25rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 0.95;
  }

  .sysmap__bridge {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: center;
    margin-top: clamp(3rem, 5vw, 4.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-soft);
  }

  .sysmap__bridge-rule {
    height: 1px;
    background: var(--line);
  }

  .sysmap__bridge > .meta-text:first-child {
    color: var(--text-primary);
  }

  .sysmap__bridge-label {
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .sysmap__grid {
      column-gap: 0.5rem;
    }

    .sysmap__project {
      font-size: 0.5rem;
      letter-spacing: 0.08em;
    }

    .sysmap__territory {
      font-size: clamp(1rem, 4vw, 1.5rem);
    }

    .sysmap__bridge {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 0.5rem;
    }

    .sysmap__bridge-rule {
      display: none;
    }
  }
</style>
