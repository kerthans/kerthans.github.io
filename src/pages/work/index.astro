---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FieldRecordPreview from '../../components/field/FieldRecordPreview.astro';
import { getCollection } from 'astro:content';
import { getLocale } from '../../i18n/utils';
import { sortWorkEntries, workDetailPath } from '../../lib/work';

const locale = getLocale(Astro.url.pathname);
const entries = sortWorkEntries(await getCollection('work', ({ data }) => data.locale === 'zh-CN'));

const typeLabels: Record<string, string> = {
  system: '系统',
  research: '研究',
  infrastructure: '基础设施',
};
---

<BaseLayout title="Work — 岳一扬">
  <main>
    <section class="site-shell work-section">
      <div class="section-meta work-section__meta">
        <span>项目</span>
        <span>系统与实验</span>
      </div>
    </section>

    {entries.map((entry) => (
      <FieldRecordPreview
        locale={locale}
        index={entry.data.record}
        signalType={typeLabels[entry.data.type] ?? entry.data.type}
        projectName={entry.data.title}
        coreQuestion={entry.data.thesis}
        metadata={entry.data.metrics ?? []}
        insight={entry.data.insight}
        recordUrl={workDetailPath(locale, entry)}
      />
    ))}
  </main>
</BaseLayout>

<style>
  .work-section {
    padding-top: clamp(8rem, 12vw, 11rem);
  }

  .work-section__meta {
    margin-bottom: 1.5rem;
  }
</style>
