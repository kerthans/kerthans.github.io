---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPageShell from '../components/core/ContentPageShell.astro';
---

<BaseLayout title="关于 — 岳一扬">
  <main>
    <ContentPageShell
      eyebrow="岳一扬 YIYANG YUE"
      title="工程师，<br />喜欢把想法做成能用的系统。"
      intro="全栈开发者，做 AI 系统、检索基础设施和几个商业项目。"
      blocks={[
        {
          label: 'NOW',
          title: '当前状态',
          body: '人在上海。最近主要在做企业检索基础设施、ProQuote 分发验证和 Agent runtime 相关实验。',
        },
        {
          label: 'APPROACH',
          title: '工作方法',
          body: '我更习惯先做出能跑的版本，再看真实使用里哪里不成立。相比长期空想，我更信任小范围交付、清楚记录和持续修改。',
          items: ['先做可运行版本', '用真实反馈修正方向', '记录关键决策和结果'],
        },
        {
          label: 'ORIENTATION',
          title: '方向',
          body: '长期关注检索基础设施、Agent 运行时、知识系统和它们在真实业务里的用法。',
        },
      ]}
    />
  </main>
</BaseLayout>
