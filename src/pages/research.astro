---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPageShell from '../components/core/ContentPageShell.astro';
---

<BaseLayout title="研究 — 岳一扬">
  <main>
    <ContentPageShell
      eyebrow="研究"
      title="一些还在验证的想法。"
      intro="研究笔记和实验记录。不是综述，是我自己正在测试、踩坑和整理的东西。"
      blocks={[
        {
          label: '检索系统',
          title: '评估驱动的检索工程',
          body: '检索系统不能只看单个回答是否相关。更重要的是用户在真实任务里有没有找到信息、证据路径是否清楚、系统漏掉了什么。',
          items: ['构建多维度评估基准', '证据路径作为检索输出', '覆盖率和空结果分析'],
        },
        {
          label: 'AGENT 系统',
          title: 'Agent 的工程化约束',
          body: 'Agent 从演示到日常可用，中间差的是边界、状态、一致性和可观测性。我在记录 runtime 层面的取舍。',
        },
        {
          label: '商业实验',
          title: '系统交付后的真实约束',
          body: 'ProQuote 让我更直接地看到，软件做出来之后，真正难的经常是进入客户流程。这里记录构建和分发之间的差距。',
        },
      ]}
    />
  </main>
</BaseLayout>
