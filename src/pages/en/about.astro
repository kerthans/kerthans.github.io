---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageShell from '../../components/core/ContentPageShell.astro';
---

<BaseLayout title="About — Yiyang Yue">
  <main>
    <ContentPageShell
      eyebrow="YIYANG YUE"
      title="ENGINEER.<br />SYSTEM BUILDER.<br />SERIAL EXPERIMENTER."
      intro="Build systems. Hand them to reality. See what survives."
      blocks={[
        {
          label: 'NOW',
          title: 'Current Status',
          body: 'Based in Shanghai. Building AI systems, retrieval infrastructure, and commercial experiments full-time. Current attention split: enterprise retrieval (50%), ProQuote distribution (30%), agent runtime research (20%).',
        },
        {
          label: 'APPROACH',
          title: 'How I Work',
          body: 'Build the smallest runnable system. Put it in front of real users. Iterate based on what breaks. Structured experiments over guessing. Traceable reasoning over intuition. Code that survives reality over perfect design.',
          items: ['Systems thinking first', 'Experiment-driven over plan-driven', 'Decisions and results documented publicly'],
        },
        {
          label: 'ORIENTATION',
          title: 'Direction',
          body: 'Interested in retrieval infrastructure, agent runtimes, and the commercial application of knowledge systems. Working to close the gap between construction and distribution.',
        },
      ]}
    />
  </main>
</BaseLayout>
