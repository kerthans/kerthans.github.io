---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageShell from '../../components/core/ContentPageShell.astro';
---

<BaseLayout title="About — Yiyang Yue">
  <main>
    <ContentPageShell
      eyebrow="YIYANG YUE"
      title="ENGINEER,<br />TURNING IDEAS INTO USABLE SYSTEMS."
      intro="Full-stack developer working on AI systems, retrieval infrastructure, and a few commercial projects."
      blocks={[
        {
          label: 'NOW',
          title: 'Current Status',
          body: 'Based in Shanghai. Recently focused on enterprise retrieval infrastructure, ProQuote distribution, and agent runtime experiments.',
        },
        {
          label: 'APPROACH',
          title: 'How I Work',
          body: 'I prefer building a small working version, putting it in real use, then changing it based on what breaks. Delivery, records, and iteration beat long stretches of guessing.',
          items: ['Build the runnable version first', 'Use real feedback to adjust direction', 'Record important decisions and outcomes'],
        },
        {
          label: 'ORIENTATION',
          title: 'Direction',
          body: 'Long-term interests: retrieval infrastructure, agent runtimes, knowledge systems, and how they show up in real businesses.',
        },
      ]}
    />
  </main>
</BaseLayout>
