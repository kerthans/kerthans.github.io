---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageShell from '../../components/core/ContentPageShell.astro';
---

<BaseLayout title="Now — Yiyang Yue">
  <main>
    <ContentPageShell
      eyebrow="NOW"
      title="WHAT I'M WORKING ON."
      intro="A few active threads. This is a current attention map, not a permanent roadmap."
      blocks={[
        {
          label: 'ENTERPRISE RETRIEVAL',
          title: 'Making RAG work in real environments',
          body: 'Enterprise retrieval is not just about relevant answers. Evidence paths, coverage, permissions, deployment constraints, and evaluation all matter. Most of my recent infrastructure work sits here.',
          items: ['Evidence path tracing', 'Multi-dimension eval suite', 'Azure deployment adaptation'],
        },
        {
          label: 'PROQUOTE',
          title: 'Distribution for ProQuote',
          body: 'ProQuote is live for managed IT service providers. Once the product worked, the next question became who needs it first and where it fits into a buying or sales workflow.',
        },
        {
          label: 'AGENT RUNTIME',
          title: 'Agent runtime boundaries',
          body: 'Reliable agents need more than one good prompt. I am looking at execution boundaries, state persistence, tool-call logs, and recovery after failures.',
        },
      ]}
    />
  </main>
</BaseLayout>
