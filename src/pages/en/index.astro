---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BootState from '../../components/core/BootState.astro';
import HeroSection from '../../components/field/HeroSection.astro';
import ActiveSignal from '../../components/field/ActiveSignal.astro';
import SystemMap from '../../components/field/SystemMap.astro';
import HomeFieldRecords from '../../components/field/HomeFieldRecords.astro';
import { getLocale } from '../../i18n/utils';

const locale = getLocale(Astro.url.pathname);
---

<BaseLayout>
  <BootState />
  <main>
    <HeroSection locale={locale} />
    <ActiveSignal locale={locale} />
    <SystemMap locale={locale} />
    <HomeFieldRecords locale={locale} />
  </main>
</BaseLayout>