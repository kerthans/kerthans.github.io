---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentPageShell from '../../components/core/ContentPageShell.astro';
---

<BaseLayout title="Research — Yiyang Yue">
  <main>
    <ContentPageShell
      eyebrow="RESEARCH"
      title="IDEAS I'M STILL TESTING."
      intro="Research notes and experiment logs. Not polished surveys, just things I am testing, breaking, and trying to understand."
      blocks={[
        {
          label: 'RETRIEVAL SYSTEMS',
          title: 'Evaluation-Driven Retrieval Engineering',
          body: 'A retrieval system should not be judged only by whether one answer looks relevant. I care about whether users find the needed information, whether evidence paths are clear, and what the system misses.',
          items: ['Building multi-dimension eval benchmarks', 'Evidence paths as retrieval output', 'Coverage and null result analysis'],
        },
        {
          label: 'AGENT SYSTEMS',
          title: 'Engineering Constraints of Agents',
          body: 'The gap between an agent demo and a usable system is mostly about boundaries, state, consistency, and observability. I am documenting those runtime-level tradeoffs.',
        },
        {
          label: 'COMMERCIAL EXPERIMENTS',
          title: 'Real Constraints After Shipping',
          body: 'ProQuote made the pattern concrete: after software is built, the hard part is often getting it into the customer workflow. This is where I track the gap between building and distribution.',
        },
      ]}
    />
  </main>
</BaseLayout>
