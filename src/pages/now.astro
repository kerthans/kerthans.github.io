---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentPageShell from '../components/core/ContentPageShell.astro';
---

<BaseLayout title="此刻 — 岳一扬">
  <main>
    <ContentPageShell
      eyebrow="目前"
      title="我最近在做什么。"
      intro="几个正在推进的方向。这里记录的是当前注意力，不是长期承诺。"
      blocks={[
        {
          label: 'ENTERPRISE RETRIEVAL',
          title: '把 RAG 做到真实场景里',
          body: '企业检索的难点不只是回答相关，还包括证据路径、覆盖率、权限、部署环境和评估方式。最近主要在补这部分基础设施。',
          items: ['证据路径追踪', '多维度评估套件', 'Azure 部署适配'],
        },
        {
          label: 'PROQUOTE',
          title: 'ProQuote 的分发验证',
          body: 'ProQuote 已上线，面向托管 IT 服务商。产品能跑之后，问题变成了谁最先需要它，以及它应该进入哪一个采购或销售流程。',
        },
        {
          label: 'AGENT RUNTIME',
          title: 'Agent 运行时的边界',
          body: 'Agent 要稳定运行，不能只靠一次 prompt。现在关注执行边界、状态保存、工具调用记录和失败恢复这些更工程化的问题。',
        },
      ]}
    />
  </main>
</BaseLayout>
